{
  "name": "embervy-memory",
  "version": "0.2.0",
  "private": true,
  "description": "Substrate-independent memory worker for an agent. Episodic + archival memory with decay-based ranking, exposed as MCP tools.",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "schema:apply:remote": "wrangler d1 execute embervy-memory --remote --file=schema.sql",
    "schema:apply:local": "wrangler d1 execute embervy-memory --local --file=schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240314.0",
    "typescript": "^5.4.0",
    "wrangler": "^3.50.0"
  }
}

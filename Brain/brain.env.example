# Optional installer settings (uncomment only when needed; blank assignments only where documented).
# Pipe settings (settings file, MCP, permissions, tool policy, prompt mode) take
# effect with /reload, without a cut; head, window, endpoints and RAG need a cut.
# BRAIN_ENV_FILE=/path/to/brain.env
# The loop scripts let this file win over the inherited environment, so an edit
# reaches Brain at the next cut. Keys listed here (space-separated, set in the
# environment, not in this file) keep an explicit outside override instead.
# BRAIN_ENV_KEEP="GPT_ADAPTER_PORT"
# Set by the loop, never by hand: the keys it took from this file. Brain rereads
# those when it needs them later (bridge depth at a cut, head menu, head switch).
# BRAIN_ENV_FILE_KEYS=
# Opt-in credential-file presence check for Claude, in the config directory the pipe runs on.
# BRAIN_CLAUDE_LOGIN_CHECK=1
# Local clock/calendar/pins/app/time marks; fallback EMBERVY_TIMEZONE, then Europe/Berlin.
# BRAIN_TIMEZONE=Europe/Berlin
# Place on the clock line (default: the zone's city, Europe/Berlin -> Berlin).
# BRAIN_CLOCK_PLACE=Berlin
# Built-in runtime and loop messages: en (this build ships English only).
# User prompts, messages and existing archives are never translated.
# BRAIN_LANG=en
# The house's own language file, shared with the app: its "brain" object
# translates the notices Brain sends to the app (`bun texts.ts --app-notices`
# lists them; everything the head reads stays English), its "language" sets the
# date and number format. Updates never touch it.
# BRAIN_STRINGS_FILE=../Claude/app/strings.local.json
# BRAIN_TEXTS_DIR is derived by scripts/brain-env.sh (where the text catalog lives); do not set it.
# /move requires BRAIN_RAG_URL + BRAIN_RAG_AUTH_TOKEN and always uploads,
# even below BRAIN_MIN_TURNS_FOR_UPLOAD. Ordinary /respawn keeps its threshold.
# Empty/whitespace ADAPTER_* values are unset; use commented examples instead.
# ADAPTER_EFFORT=high
# Effort is remembered per head in BRAIN_STATE_DIR/brain-effort.json (perHead map).
# /head gpt <model> pipe effort=high selects the adapter's start effort transactionally.
# /move claude effort=xhigh selects Claude's start effort without changing the old head.
# Optional per-head defaults; remembered levels (including default/null) win.
# BRAIN_CLAUDE_EFFORT=xhigh
# BRAIN_GPT_EFFORT=high
# ADAPTER_VERBOSITY=low

# Model endpoint and credentials
# API credential for the OpenAI-compatible model endpoint.
BRAIN_API_KEY=<model-api-key>
# OpenAI-compatible chat-completions endpoint used for model turns.
BRAIN_ENDPOINT=https://provider.example.invalid/v1/chat/completions
# Model identifier sent in each request.
BRAIN_MODEL=<model-id>
# The house's own system prompt (an Embervy house: EMBERVY.md), read afresh at every
# pipe start and API turn. Keep no CLAUDE.md/AGENTS.md beside it: a pipe head would load both.
BRAIN_SYSTEM=./Brain/system_prompt.md
# An absolute notes directory gives every head a fresh NOTES.md index at each pipe start or API turn.
# BRAIN_NOTES_DIR=/path/to/notes
# Brain-owned notes disable CLI auto-memory so the notebook appears only once.
# The independent byte cap bounds index reads and adds a visible truncation notice (default 25000).
# BRAIN_NOTES_MAX_BYTES=25000
# Ordered colon-separated context files (absolute paths recommended), fresh per pipe start/API turn.
# BRAIN_CONTEXT_FILES=/path/to/notes.md:/path/to/memory/index.md
# UTF-8 byte cap per file (truncation/missing files are logged, no startup failure).
# BRAIN_CONTEXT_FILE_MAX_BYTES=80000
# BRAIN_<HEAD>_SYSTEM_PROMPT_MODE is per head; no global mode.
# Unset, blank or invalid means replace for pipe heads and append for API heads; explicit replace or append wins for both.
# Pipe replace: only the house's own prompt, no Claude Code base prompt; append keeps the base prompt in front.
# API heads have no CLI base prompt; only explicit replace enables the tool-rules chapter and automatic CLI capture.
# BRAIN_CLAUDE_SYSTEM_PROMPT_MODE=append
# BRAIN_GPT_SYSTEM_PROMPT_MODE=append
# BRAIN_GROK_SYSTEM_PROMPT_MODE=append
# BRAIN_KIMI_SYSTEM_PROMPT_MODE=append
# BRAIN_GLM_SYSTEM_PROMPT_MODE=append
# BRAIN_API_SYSTEM_PROMPT_MODE=append
# Optional override of automatically captured Claude tool guidance in replace mode; missing file uses built-in rules.
# BRAIN_TOOL_RULES_FILE=/path/to/tool-rules.md
# Built-in tool policy for EVERY pipe head, including Claude (not resident/API tools).
# Default deny: DesignSync,CronCreate,CronDelete,CronList,RemoteTrigger,NotebookEdit,EnterWorktree,ExitWorktree,ScheduleWakeup
# Additional denies: comma-separated exact CLI tool names; whitespace/duplicates removed.
# BRAIN_DISALLOWED_TOOLS=SomeOtherBuiltin
# BRAIN_GPT_DISALLOWED_TOOLS=SomeOtherBuiltin,AnotherBuiltin
# For either setting, a nonblank BRAIN_<HEAD>_* replaces the global fallback;
# blank/unset uses the fallback. Empty deny lists do NOT remove the defaults.
# Opt individual tools back in (only removes default denies, never explicit denies,
# permission restrictions or the engine's native-web compatibility restrictions).
# BRAIN_ENABLE_TOOLS=NotebookEdit
# BRAIN_CLAUDE_ENABLE_TOOLS=NotebookEdit,EnterWorktree,ExitWorktree
# To restore all nine built-ins, list all nine under BRAIN_<HEAD>_ENABLE_TOOLS.
# Applies at the next pipe start. Agent,SendMessage,Monitor,Skill,ToolSearch,TaskStop
# and Claude's WebSearch/WebFetch are NOT disabled by this default policy.
# Optional /usage prices: JSON keyed by exact served model, USD/M for input/output/cache_read/cache_write; unset shows —.
# BRAIN_PRICES_FILE=/path/to/model-prices.json
# Unset or empty: temperature is not sent; the provider default applies.
# Set a finite number only if the model accepts temperature; invalid values warn and are ignored.
BRAIN_TEMPERATURE=
# Maximum model/tool requests allowed in one turn.
BRAIN_MAX_TOOL_HOPS=<maximum-tool-hops>
# Off by default. The builder add-on sets BRAIN_PIPE_MAX_TOOL_HOPS for its own runs to cap
# tool requests per Claude turn; a resident leaves it unset, its turns may run long.
# Maximum time in minutes for one model request.
BRAIN_REQUEST_TIMEOUT_MIN=<request-timeout-minutes>
# Optional: take only the named keys from another env file (for example the
# keys your MCP servers expect). ANTHROPIC_* keys are never imported.
BRAIN_IMPORT_ENV_FILE=<path-to-env-file>
BRAIN_IMPORT_ENV_KEYS=<KEY_ONE,KEY_TWO>

# Worker identity and local files
# Set the house root explicitly, not Brain's runtime subdirectory.
# EMBERVY_HOME=/opt/embervy
# Give each house its own socket; mirror both socket keys into root/app env files.
# EMBERVY_TMUX_SOCKET=brain
# BRAIN_TMUX_SOCKET=brain
# Manual runs must start under env -i; the profile cannot remove inherited keys it does not list.
# Display and transcript name for the worker.
BRAIN_WORKER_NAME=<worker-name>
# Display and transcript name for the user.
BRAIN_USER_NAME=<user-name>
# Directory for event and conversation JSONL logs.
BRAIN_LOG_DIR=./Brain/logs
# BRAIN_TOOL_REFERENCES is a startup JSON array: tool, optional exact top-level scalar
# when:{field,equals}, optional allow (up to 16 non-personal scalar fields). MCP prefixes
# do not affect matching. Matching results become tool/id/character-count references;
# arguments retain only the condition and allowed fields, with counts for the rest.
# Logs, saved history and terminal tool views change, never the running model context.
# Empty/unset keeps full records; each invalid entry emits one content-free event.
# Unattributed CLI diagnostics/endpoint errors are omitted when valid rules exist;
# prose, deliberate tool writes and existing files stay as written.
# BRAIN_TOOL_REFERENCES='[{"tool":"mailbox","when":{"field":"postfach","equals":"info"},"allow":["action","kunde","id"]},{"tool":"draft_mail"}]'
# The Claude pipe uses --no-session-persistence to prevent a second CLI transcript.
# Persisted self-context block path.
BRAIN_SELF_FILE=./Brain/self.md
# Persisted user-context block path.
BRAIN_USER_FILE=./Brain/user.md
# Bridge file loaded once and written during archival.
BRAIN_BRIDGE_FILE=./Brain/logs/bridge.md
# Bridge depth, either/or (the wake capsule sits on top in both):
#   turns    (default) the last BRAIN_BRIDGE_TURNS cleaned user turns, across session borders
#   sessions the last BRAIN_BRIDGE_SESSIONS whole sessions (one session runs between two cuts)
BRAIN_BRIDGE_MODE=turns
# turns mode: number of recent user turns in the bridge (default 40; also the
# "this session so far" block of a pipe restart).
BRAIN_BRIDGE_TURNS=<bridge-turn-count>
# sessions mode: number of SUBSTANTIAL whole sessions (default 2); a session counts
# with at least BRAIN_BRIDGE_MIN_USER_TURNS user turns (default 8), thinner ones
# ride along, at most sessions+2.
BRAIN_BRIDGE_SESSIONS=2
BRAIN_BRIDGE_MIN_USER_TURNS=8
# Emergency ceiling at every use, per head — an upper limit, never a target: the
# depth above alone decides the size, nothing grows toward it. Only a bridge bigger
# than this share of the current head's watchdog cut (tokens × 3.6 bytes; default
# 0.5, 0 = only the byte ceiling) or than BRAIN_BRIDGE_MAX_BYTES (default 500000,
# 0 = no absolute ceiling) is clipped: whole turns, the oldest first, the capsule
# stays. The file itself is never cut. (BRAIN_BRIDGE_WINDOW_SHARE is superseded
# and ignored.)
BRAIN_BRIDGE_CUT_SHARE=0.5
BRAIN_BRIDGE_MAX_BYTES=500000
# BRAIN_BRIDGE_FRESH_CHARS and BRAIN_QUICK_CUT are set by the quick-cut add-on; otherwise leave them off.
# Optional: a one-shot marker file; when it exists at a cut, the bridge is written
# empty (the next session starts bare) and the marker is removed.
BRAIN_BRIDGE_NO_BRIDGE_MARKER=<marker-file-or-empty>
# Optional explicit session archive name.
BRAIN_SESSION_NAME=<optional-session-name>
# Directory for local Markdown session archives.
BRAIN_SESSION_ARCHIVE_DIR=./Brain/logs/sessions
# Minimum real turns (the person's or the agent's) for an archive and RAG upload; default 1.
BRAIN_MIN_TURNS_FOR_UPLOAD=<minimum-turn-count-before-upload>

# Optional memory MCP and RAG
# Base URL of the optional memory MCP service.
BRAIN_MEMORY_URL=https://memory.example.invalid
# Bearer credential for the memory MCP service.
BRAIN_MEMORY_API_KEY=<memory-api-key>
# Base URL of the optional RAG service.
BRAIN_RAG_URL=https://rag.example.invalid
# Bearer credential for the RAG service.
BRAIN_RAG_AUTH_TOKEN=<rag-auth-token>
# BRAIN_RAG_FILENAME_PREFIX=Builder_ # Only this filename prefix is searched; the Builder add-on sets Builder_.
# Enables or disables pre-turn inlet retrieval.
BRAIN_INLET=<true-or-false>
# Number of turns for suppressing repeated inlet blocks.
BRAIN_INLET_DEDUPE_TURN_TTL=<inlet-dedupe-turn-count>
# Visible-context token budget; zero disables rolling.
BRAIN_ROLLING_TOKENS=<rolling-token-budget-or-zero>
# Approximate visible history to retain after rolling; defaults to floor(BRAIN_ROLLING_TOKENS / 2).
# Invalid, nonpositive or >= BRAIN_ROLLING_TOKENS values use that default; >= logs once.
# BRAIN_ROLLING_KEEP_TOKENS=115000
# Optional segment-size lower bound, not a separate default or a cap.
# Larger segments cost less because every roll breaks the provider's prompt cache.
# BRAIN_ROLLING_SEGMENT_TOKENS=40000

# Optional read-only workspace and explicitly allowed writes
# Root directory for read-only workspace tools.
BRAIN_WORKSPACE_READ=./workspace
# File containing explicitly released writable paths.
BRAIN_WORKSPACE_WRITE_LIST=./workspace-write-allowlist.txt
# Directory for backups made before an allowed write.
BRAIN_WORKSPACE_BACKUP_DIR=./Brain/backups

# Web search and fetch (web-tools.ts) — for every head that does not bring its own.
# The claude head on Anthropic uses Claude Code's WebSearch/WebFetch; API heads
# get web_search/web_fetch as tools; pipe heads on other engines (glm, kimi) get
# them through the control endpoint (needs BRAIN_CONTROL_TOKEN below).
# Search backend: brave | tavily | searxng | off. Empty: no web_search is offered.
#   brave    paid per request, monthly credit; key from the Brave Search API dashboard
#   tavily   monthly free credits, no card; key tvly-…
#   searxng  your own instance, no account (enable the json format in its settings.yml)
# Older setups with only BRAIN_WEB_SEARCH_API_KEY (+ ENDPOINT) keep running as brave.
BRAIN_WEB_SEARCH_BACKEND=<brave|tavily|searxng|off>
# Key for brave/tavily; optional for searxng (sent as a bearer to a proxy in front of it).
BRAIN_WEB_SEARCH_API_KEY=<web-search-api-key>
# Endpoint override (brave/tavily have defaults); required for searxng, e.g. http://127.0.0.1:8888
BRAIN_WEB_SEARCH_ENDPOINT=https://search.example.invalid/web
BRAIN_WEB_SEARCH_TIMEOUT_MS=20000
# web_fetch: one public page as readable text (on by default; off switches it off).
# Local, private, link-local and metadata addresses are refused after DNS and on
# every redirect.
BRAIN_WEB_FETCH=on
BRAIN_WEB_FETCH_TIMEOUT_MS=20000
# Download cap (bytes) and cap on the text returned per call (characters; the
# rest comes with offset).
BRAIN_WEB_FETCH_MAX_BYTES=2000000
BRAIN_WEB_FETCH_MAX_CHARS=20000
# Rendering pages that need JavaScript with the browser module
# (shared/tools/browser/browse.py): auto (find it next to Brain or under
# EMBERVY_HOME, use it when installed) | off | <path to browse.py>.
BRAIN_WEB_BROWSER=auto
# Time limit for one browse CLI call (the CLI itself waits up to 60 s, a first
# call may start the browser daemon).
BRAIN_WEB_BROWSER_TIMEOUT_MS=100000

# Context watchdog thresholds (global; BRAIN_<HEAD>_WATCHDOG_* win per head).
# Unset: GPT 200000/220000, Claude 800000/900000, other heads 80 %/90 % of their
# window. Reread when this file changes: raise them during a session, no cut.
# A cut above 95 % of the running head's window is clamped there.
# Prompt-token estimate at which a warning is emitted.
BRAIN_WATCHDOG_WARN=<warning-token-threshold>
# Prompt-token estimate at which archival is requested.
BRAIN_WATCHDOG_CUT=<cut-token-threshold>

# ── Brain additions (all optional) ──
# Which head thinks: claude | gpt | grok | kimi | glm | api (api = BRAIN_ENDPOINT above).
BRAIN_HEAD=<head>
# State directory (context state, cursor, pins, stop marker).
BRAIN_STATE_DIR=./Brain/state
# Durable head/model/transport/window choice. /head, /model and /move save it;
# it wins over BRAIN_HEAD on later starts. Invalid/unknown files use env (logged).
# /move <head> [model] [bridge=N] [window=250k|1m|500000] cuts before switching.
# bridge=N selects sessions for that cut only; it is never stored in this file.
BRAIN_HEAD_FILE=<file, default BRAIN_STATE_DIR/brain-head.json>
# RAG archive prefix (Session_N by default).
BRAIN_SESSION_PREFIX=<prefix>
# Park a copy of each uploaded archive for an external header job (house style header).
BRAIN_ARCHIVE_PARK_DIR=<dir-or-empty>
# Command that writes the real chronicle header (THEMES, SUMMARY, …) in place of the
# placeholders before an archive goes out, called with the archive file; empty keeps them.
# The helper runs in EMBERVY_HOME with project,local settings, account connectors
# disabled and the house's inline auto-rag-header agent; it needs a Claude login.
# Failure keeps the transcript and placeholder fields, with a diagnostic.
BRAIN_HEADER_ENRICH_CMD=<home>/Claude/scripts/enrich-header.sh
# Pipe head (claude -p): working directory, settings, sources, extra MCP config.
BRAIN_CLAUDE_CWD=<project-dir>
BRAIN_CLAUDE_MODEL=<claude-model-id>
# Put the full tool allow list in this private flag-settings file (mode 600).
# Project permissions.allow is ignored until interactive workspace trust;
# --settings is not filtered by that trust gate. See step 6b of the install
# guide, https://github.com/Embervy-ai/embervy/blob/main/INSTALL.md.
BRAIN_CLAUDE_SETTINGS=<settings-file-or-json>
# Exclude user-level hooks that may belong to another house on a shared account.
BRAIN_CLAUDE_SETTING_SOURCES=project,local
BRAIN_PIPE_MCP_CONFIG=<extra-mcp-json-or-empty>
# none (deny prompts, default) | app (approval card, needs BRAIN_CONTROL_TOKEN) | cli
BRAIN_PIPE_PERMISSION=none
BRAIN_CONTROL_TOKEN=<random-hex-32>
# Choose an unused loopback port for every house; see the neighbour section
# of the install guide (same address).
BRAIN_CONTROL_PORT=3910
# Pipe timeouts: silence limit of one stdout read (default 600000 ms), and while a
# tool call or an approval card is open (default 1900000 ms, above the 30 min card).
BRAIN_CLAUDE_PIPE_TURN_TIMEOUT_MS=600000
BRAIN_CLAUDE_PIPE_TOOL_TIMEOUT_MS=1900000
# Reasoning effort: low | medium | high | xhigh | max (empty = the model's own default).
# Only the START level: /effort (terminal, app) and the head's own effort tool change it
# live, and the last value is kept in BRAIN_EFFORT_FILE across cut and respawn (the file
# wins over this). Fallback start level: CLAUDE_CODE_EFFORT_LEVEL — never passed on to
# the pipe itself, because the CLI ranks that variable above every live change.
# BRAIN_EFFORT=high
BRAIN_EFFORT_FILE=<file, default BRAIN_STATE_DIR/brain-effort.json>
# Session ids of Brain's own pipes, so house scripts that pick "the newest session" skip them.
BRAIN_PIPE_SESSION_DENYLIST=<file, default BRAIN_STATE_DIR/brain-pipe-sessions.txt>
# Head table (heads.ts). Every value has a default; set only what differs.
# claude: model and window (BRAIN_MODEL_CLAUDE is an older alias of BRAIN_CLAUDE_MODEL).
BRAIN_CLAUDE_CONTEXT=1000000
# gpt: the chatgpt-oauth adapter (3041 is the Claude Code harness adapter's default; give Brain its own port).
# BRAIN_GPT_ADAPTER_PORT is an alias; nonblank GPT_ADAPTER_PORT wins (heads and loop).
# /health must prove ok=true, backend=chatgpt-oauth, own numeric port, own identity
# and the desired model. identity = sha256("gpt-adapter:" + cache key).hex()[0:16].
# Use a distinct port/cache key per house.
GPT_ADAPTER_PORT=<adapter-port>
# /move gpt, /head gpt and /model on GPT verify before saving/switching/cutting.
# Requires systemd's system bus: systemd-run creates the transient unit
# brain-gpt-adapter-<identity>.service; only systemctl stop of that unit may stop it.
# No bare-PID kill or setsid fallback. Legacy adapters outside the unit are refused.
# InvocationID is captured at own start in BRAIN_STATE_DIR/<unit>.owner.json.
# Reuse/stop require that exact invocation; copied unit metadata is not ownership.
# Model/Unit/State change transactionally: failed B start/finalizer/commit restores A.
# /move finalizes bridge/archive/configured RAG before saving; failure does not exit.
# An empty port permits a unit start; no fallback path or CLI login.
BRAIN_GPT_ADAPTER=<path-to-chatgpt-oauth-adapter.ts>
# ADAPTER_MODEL is the chosen model (not just this env default; requests cannot
# change the adapter's model). ADAPTER_CACHE_KEY is this value.
# REQUIRED and resident-unique: ^[A-Za-z0-9._-]{1,128}$, no whitespace/Unicode/trim.
# Unset/invalid disables GPT. No basename default.
# All nonblank ADAPTER_* knobs pass to the unit and its rollback plan.
# Health proves effort/verbosity/reasoning_context/reasoning_replay/web_search/
# native_web_search/turn_state_recovery against that plan; missing fields fail.
# A changed desired profile replaces only an OWN unit, transactionally with rollback.
# Adapter cwd: BRAIN_HOME (defaults to Brain's runtime directory).
# Log: BRAIN_LOG_DIR/chatgpt-oauth-adapter.log (systemd StandardOutput/StandardError=append).
BRAIN_GPT_CACHE_KEY=<per-house-cache-key>
# Optional auth path passed as CHATGPT_AUTH_FILE; default ~/.codex/auth.json.
# CHATGPT_AUTH_FILE=/path/to/subscription-auth.json
BRAIN_GPT_MODEL=gpt-5.6-terra
# Optional installer GPT profile (never global thresholds: later heads keep their own).
# Window = what the model can do: the subscription carries 1M. Warn/cut = cost:
# a later cut uses more of the subscription with every message, and GPT currently adds
# a long-context surcharge on long input: check the provider's current terms first. Raise warn/cut here
# at any time without a cut, up to the window (above 95 % of it the cut is clamped).
# A window saved in brain-head.json by /head or /move wins at startup over
# BRAIN_GPT_CONTEXT, and /head gpt on the same head keeps it: change a stored
# window once with /move gpt window=1m.
# BRAIN_GPT_CONTEXT=1000000
# BRAIN_GPT_WATCHDOG_WARN=200000
# BRAIN_GPT_WATCHDOG_CUT=220000
# api (default) or pipe (the adapter's Anthropic front through claude -p).
BRAIN_GPT_TRANSPORT=api
# grok: xAI chat completions. Default model grok-4.7 (500k window).
# Model documentation: https://docs.x.ai/docs/models. Key: XAI_API_KEY or:
BRAIN_GROK_API_KEY=<xai-api-key>
BRAIN_GROK_MODEL=grok-4.7
BRAIN_GROK_CONTEXT=500000
BRAIN_GROK_ENDPOINT=https://api.x.ai/v1/chat/completions
# kimi (pipe with engine env). Key: KIMI_CODE_KEY or:
BRAIN_KIMI_API_KEY=<kimi-code-key>
BRAIN_KIMI_BASE=https://api.kimi.com/coding
BRAIN_KIMI_MODEL=kimi-for-coding
BRAIN_KIMI_CONTEXT=256000
# glm (pipe with engine env). Key: GLM_CODE_KEY or:
BRAIN_GLM_API_KEY=<glm-code-key>
BRAIN_GLM_BASE=https://api.z.ai/api/anthropic
BRAIN_GLM_MODEL=glm-5.2[1m]
BRAIN_GLM_CONTEXT=1000000
# api head (BRAIN_ENDPOINT): the window the watchdog thresholds derive from.
BRAIN_CONTEXT_WINDOW=1000000
# The sense block before every turn (model, window, calendar, weather, due reminders, clock).
BRAIN_SENSE=on
# Greeting turn after every start (cut, respawn): sent after BRAIN_GREET_DELAY_MS
# unless a person has already written. Optional switch file: only if it exists.
BRAIN_GREET_PROMPT=<prompt-or-empty>
BRAIN_GREET_FLAG_FILE=<file-or-empty>
BRAIN_GREET_DELAY_MS=<milliseconds>
BRAIN_INLET_WORKER=<worker-script-or-empty>
BRAIN_INLET_WORKER_CWD=<dir>
# Worker time limit in ms (default 30000). A configured worker is the only
# retrieval voice: empty output or BYPASS = no inlet this turn; a failure is
# logged (inlet_worker_failed) and the turn goes without inlet.
BRAIN_INLET_WORKER_TIMEOUT_MS=<milliseconds>
# Append the worker's stderr (its diagnostics) to this file; empty = drop it.
# The worker gets INLET_COUNTER_FILE and INLET_CHUNK_CACHE_DIR per session
# (state/inlet-turn-counter-<session>, state/inlet-chunk-cache/<session>).
BRAIN_INLET_WORKER_LOG=<log-file-or-empty>
BRAIN_CALENDAR_FILE=<calendar-json-or-empty>
# The user's own calendars as the product app caches them (data/calendar-external.json,
# written while CALENDAR_ICS_URLS is set): their entries show as "(<BRAIN_USER_NAME>)".
# With this set, a missing BRAIN_CALENDAR_FILE counts as an empty calendar, not as silence.
BRAIN_CALENDAR_EXTERNAL_FILE=<calendar-external-json-or-empty>
BRAIN_WEATHER_URL=<open-meteo-url-or-empty>
BRAIN_WEATHER_PLACE=<place>
# Due reminders (memory todos with due_at): the pending file, and Brain's own collector (1 = on).
# The collector looks every 5 minutes. A reminder nothing else delivered wakes the agent after
# BRAIN_REMINDERS_ESCALATE_MIN minutes; 0 makes it a punctual alarm (each alarm is one turn).
BRAIN_REMINDERS_PENDING=<pending-jsonl>
BRAIN_REMINDERS_COLLECT=0
BRAIN_REMINDERS_ESCALATE_MIN=60
BRAIN_PINS_FILE=<pins-json>
BRAIN_PINS_FORMAT=brain
# App channel (no default inbox on purpose).
# Ordered JSONL bytes per read (default 262144); remainder waits, an oversized entry goes alone.
# BRAIN_INBOX_BATCH_BYTES=262144
# BRAIN_INBOX_BACKLOG_CAP and BRAIN_INBOX_BACKLOG_KEEP are ignored; no count-based dropping.
# Exact text repeats from the same sender within a read carry repeat_count; images/files never collapse.
BRAIN_APP_INBOX_FILE=<inbox-jsonl-or-empty>
BRAIN_APP_URL=<http://127.0.0.1:port>
BRAIN_APP_TOKEN=<app-internal-token>
BRAIN_APP_SOURCE=<channel-source-name>
# App MCP tool namespace and default channel source (default app, the product app's server; a house with its own app sets its name).
# BRAIN_APP_MCP_SERVER=app
BRAIN_APPROVAL=off
# The shared reply-gateway-off file disables fallback prose and retries immediately while it exists.
# The default follows EMBERVY_HOME/state, then BRAIN_STATE_DIR, then Brain's local state directory.
# BRAIN_REPLY_GATEWAY_OFF_FILE=/path/to/house/state/reply-gateway-off
# Read once, on the first start with the file switch: anything but "on" (unset was the old off) creates the file; a stamp beside it keeps a later start from undoing a change.
# BRAIN_REPLY_GATEWAY=off
# Optional REPLY/NOTE classifier after the gateway rules (reply-gateway.sh: gemma on OpenRouter).
# NOTE suppresses the ⚡ send; no key, HTTP error or timeout → send (fail-open). Claude models are refused.
BRAIN_REPLY_GATEWAY_CLASSIFIER=off
BRAIN_REPLY_GATEWAY_CLASSIFIER_URL=https://openrouter.ai/api/v1/chat/completions
BRAIN_REPLY_GATEWAY_CLASSIFIER_MODEL=google/gemma-3-27b-it
# Falls back to OPENROUTER_API_KEY.
BRAIN_REPLY_GATEWAY_CLASSIFIER_KEY=<openrouter-api-key>
BRAIN_REPLY_GATEWAY_CLASSIFIER_TIMEOUT_MS=8000
# At a cut or a rolling export, wait at most this long for gateway deliveries still in flight;
# a delivery that has not answered by then stays out of the bridge and the archive.
# BRAIN_GATEWAY_SETTLE_MS=5000
# Catch-up after a crash: every conversation log with a real turn that the archive
# ledger (state dir, archive-ledger.jsonl) does not list is archived in the
# background after the start, oldest first, without a time window.
BRAIN_CATCHUP=on
# API approval patterns: default (built-in set), off (no rules), or a file path.
# Only used with BRAIN_APPROVAL=app; loaded once at startup.
BRAIN_APPROVAL_RULES=default
# Pipe app + control token: the same rules ask through PreToolUse, overriding Claude Code allow rules; pipe none keeps its own settings.
# Rules file: one JSON array per line [tool, field, regex source, label].
# Blank lines and lines starting with # are ignored. Regexes are case-insensitive;
# JSON backslashes must be doubled. Tool names match with or without MCP prefixes.
# Missing/non-string fields do not match. First matching rule supplies the card label.
# Example lines in the rules file (without the leading comment marker):
# ["bash", "command", "\\brm\\s+-[a-z]*[rf]", "deletes"]
# ["mailbox", "action", "^send$", "sends"]
# Unreadable files and invalid lines log an event and are skipped, never replaced
# by defaults. A custom file replaces the built-in set, rather than extending it.
# Always ask for these exact tool names, regardless of input; default is empty.
# BRAIN_APPROVAL_RULES=off does not disable this explicit whole-tool list.
# BRAIN_APPROVAL_TOOLS=write_file,edit_file,bash,task_start
# Optional colon-separated absolute scratch directories exempt only literal child rm targets; unset or empty keeps cards unchanged.
# Symlinks cannot be excluded textually, so this exception is for directories written only by the agent itself.
# BRAIN_APPROVAL_SCRATCH=/scratch:/work/agent-scratch
# The app's approval level (an Embervy installation): the app alone writes this file,
# {"level": "all"|"important"|"none", "extra": [{label, tool, field, pattern}]}.
# Read fresh at every decision. With it, the level replaces BRAIN_APPROVAL_RULES and
# BRAIN_APPROVAL_TOOLS; a broken file means important, never none, and is reported.
# BRAIN_APPROVAL_SETTINGS=/opt/embervy/Claude/app/data/approval-settings.json
# The startup house check: run once per session at the first start, its findings and
# Brain's own fallbacks go to the person as one app message and to the agent as one
# [house check] block. With it set, a missing or empty identity file stops the start.
# BRAIN_DOCTOR_CMD=bun /opt/embervy/shared/tools/embervy-doctor.ts --startup --json
# API heads' hands (resident-tools.ts). grep/glob come with BRAIN_WORKSPACE_READ.
# bash + task_start/task_status/task_output only with BRAIN_SHELL=on (never in a
# sterile instance): working directory jailed to BRAIN_WORKSPACE_READ, env without
# BRAIN_* and credentials, timeout, output caps. The shell is not a sandbox —
# run it with BRAIN_APPROVAL=app.
BRAIN_SHELL=off
BRAIN_SHELL_TIMEOUT_MS=120000
# Background task logs (default BRAIN_LOG_DIR/tasks); registry: BRAIN_STATE_DIR/resident-tasks.json.
BRAIN_TASKS_DIR=<dir>
# House-compatible files.
# watchdog_state.json in the format of the house context_watchdog.sh (the app tool
# watchdog_status); default BRAIN_STATE_DIR/watchdog_state.json, "off" disables.
BRAIN_WATCHDOG_STATE=<path-or-off>
# Upload ledger: after each confirmed RAG upload one line basename:size:mtime:NAME
# (the session-to-rag.sh format). Empty = off.
BRAIN_UPLOAD_LEDGER=<path-or-empty>
# API heads: house stdio MCP servers and browser CLI.
BRAIN_MCP_CONFIG=<.mcp.json-or-empty>
BRAIN_MCP_SERVERS=<comma-list-or-empty>
BRAIN_BROWSER_COMMAND=<browser-cli-or-empty>
# Cache ping (a keep-warm turn after this many idle minutes; auto = the Claude pipe only), guards.
BRAIN_CACHE_PING=auto
BRAIN_CACHE_PING_MINUTES=50
# BRAIN_CACHE_PING_MINUTES_<HEAD> (uppercase head name) overrides the minutes for that head, for providers whose cache expires sooner or later.
# BRAIN_CACHE_PING_MINUTES_GPT=25
# Unset: BRAIN_STATE_DIR/brain.pid lifetime lock; BRAIN_LOCK_FILE= explicitly disables it.
# BRAIN_LOCK_FILE=/path/to/brain.pid
BRAIN_PARALLEL_PATTERN=<pgrep-pattern-or-empty>
BRAIN_HOUSE_MAP=on
# Agent-owned capabilities, read once per process start with the house map for every head.
# Unset: CAPABILITIES.md in the parent of the Brain directory (the installed house root).
# Missing adds nothing; unreadable or larger than 65536 bytes adds a short notice.
# BRAIN_CAPABILITIES_FILE=/path/to/CAPABILITIES.md
# Agent-owned map appended verbatim; missing configured file gets one quiet reminder.
# BRAIN_HOUSE_MAP_EXTRA_FILE=/path/to/my-house.md
# Installer facts delivered once as an internal turn, before the ordinary greeting.
# Marker BRAIN_STATE_DIR/first-turn-delivered is committed at turn START.
# BRAIN_FIRST_TURN_FILE=/path/to/first-turn.md

# Model choices per head for /heads and a menu (control endpoint GET /heads): id=Label,id=Label
# (BRAIN_CLAUDE_MODELS, BRAIN_GPT_MODELS, BRAIN_GROK_MODELS, BRAIN_KIMI_MODELS, BRAIN_GLM_MODELS)
# claude: the CLI's own catalog comes first; configured ids it does not show follow as "more".
BRAIN_CLAUDE_MODELS=<id=Label,id=Label>
BRAIN_GPT_MODELS=<id=Label,id=Label>
BRAIN_GROK_MODELS=<id=Label,id=Label>
BRAIN_KIMI_MODELS=<id=Label,id=Label>
BRAIN_GLM_MODELS=<id=Label,id=Label>

# Live view in the terminal for pipe and API heads (on|off, default on):
# one short line per tool step, helper start/end and the helper count.
# Never file or message contents, never tool results.
BRAIN_LIVE_VIEW=on

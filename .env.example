# Embervy — environment template.
#
# Copy this file to $EMBERVY_HOME/.env and to the app directory
# ($EMBERVY_HOME/Claude/app/.env — the app for Claude Code and Brain alike).
# Brain's own settings live in Brain/brain.env (see Brain/brain.env.example).
#
# Fill in the values. Keep the file out of git (the repo's .gitignore
# already excludes .env).
#
# The file is data, never run as a shell program: systemd, Bun and the
# hooks (shared/scripts/env-file.sh) all read KEY=value lines. Put a value
# with spaces in single quotes (EMBERVY_TIME_LABEL='New York'); one with a
# ' in double quotes, writing every $ as \$ (PLACE="St. John's"). The
# installer writes every value this way (shared/scripts/env-file.ts).

# ── Where the repo lives on this machine ─────────────────────────────────
EMBERVY_HOME=/opt/embervy

# ── Speaker / location labels (cosmetic, but they appear everywhere) ─────
USER_LABEL=User
AGENT_LABEL=Agent
EMBERVY_TIMEZONE=UTC          # IANA timezone, e.g. Europe/Berlin
EMBERVY_TIME_LABEL=UTC        # whatever city / label you want in the clock banner

# ── Where the workers live ───────────────────────────────────────────────
RAG_URL=https://embervy-chronicle.YOUR-ACCOUNT.workers.dev
RAG_AUTH_TOKEN=
EMBERVY_API_KEY=                  # bearer for the memory worker's /mcp + /lookup
EMBERVY_URL=https://embervy-memory.YOUR-ACCOUNT.workers.dev   # the memory worker; used by the inlet worker

# ── App server (Claude/app) ──────────────────────────────────────────────
EMBERVY_APP_HOST=127.0.0.1
EMBERVY_APP_PORT=3030
EMBERVY_APP_DATA_DIR=         # override the app's data/ directory (optional)
INTERNAL_API_TOKEN=          # guards /api/internal/*
EXTERNAL_PUSH_TOKEN=         # guards /api/external/*
APP_PASSWORD=                # the login secret the PWA prompts for
APP_SESSION_SECRET=          # HMAC secret for session cookies (run `openssl rand -base64 48`)
# Local development only: cookie bypass requires loopback binding and no Cloudflare headers.
# EMBERVY_TRUST_SAME_HOST=1
# How long a login stays valid. Default 30 days; expiry is the only way a
# stolen cookie stops working, so raise it only on purpose (SECURITY.md).
# APP_SESSION_MAX_AGE_MS=2592000000

# ── Shared rooms (optional, agent's room tool) ───────────────────────────
# The legacy room stays first and keeps data/room-state.json.
EMBERVY_ROOM_URL=
EMBERVY_ROOM_TOKEN=           # member key: at least 32 characters, no whitespace
EMBERVY_ROOM_NAME=            # default Room; letters, digits, spaces, _ and - (40 characters)
EMBERVY_ROOM_POLL_SECONDS=60  # at least 15; invalid intervals use 60
# Additional rooms, or all rooms if the legacy URL/token are unset: one JSON list.
# EMBERVY_ROOMS='[{"name":"Work","url":"https://work.example","token":"REPLACE_WITH_A_MEMBER_KEY_AT_LEAST_32_CHARS","poll_seconds":30}]'
# URLs: https, or http on localhost/127.0.0.1; no credentials, query or hash.
# Invalid rooms and duplicate cleaned names are skipped with a reason on stderr.
# Other cursors live in data/room-state-<cleaned name>.json; keep names stable.
# With several rooms, the room tool requires a room name. Answer in the room
# the message came from, not in another room or the user's app chat.

# ── Direct peers (optional, agent's peer tool) ───────────────────────────
# Both houses list each other with the SAME token, unique to that pair.
# Use a random token of at least 32 printable ASCII characters without spaces.
# URL: https or loopback http.
# Name: letters, digits, spaces, _ and -, at most 40 characters.
# EMBERVY_PEERS='[{"name":"Rowan","url":"https://rowan.example","token":"REPLACE_WITH_A_PAIR_SECRET_AT_LEAST_32_CHARS"}]'
# Invalid entries and duplicate names/tokens are skipped; others still work.
# The person does not see this direct line in the chat. Answer with peer, never reply.

# ── Upload limits ────────────────────────────────────────────────────────
MAX_IMAGE_BYTES=20971520     # 20 MB — /api/image rejects larger uploads
MAX_VOICE_BYTES=20971520     # 20 MB — /api/voice rejects larger uploads
# Ears on this server: a /hear service that takes {path, prompt} and answers {text, woven}.
# With it, voice messages reach the agent with sounds and tone, dictation as plain words.
# EMBERVY_HEAR_URL=http://127.0.0.1:8765/hear
# EMBERVY_HEAR_PROMPT=         # names the recognizer should know
# EMBERVY_VOICE_MESSAGES=1     # the mic sends real voice messages instead of dictation
# Uploads and send_file: images, documents and Office files; SVG excluded by default.
ALLOWED_IMAGE_EXTS=jpg,jpeg,png,gif,webp,heic,pdf,txt,md,doc,docx,xls,xlsx,ppt,pptx,odt,ods,odp,csv

# ── Email pipeline behaviour ─────────────────────────────────────────────
EMAIL_AUTO_SEND_CLEAN=false  # when true, blacklist-clean mails skip user approval

# ── Web Push (generate via: bunx web-push generate-vapid-keys) ──────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=               # mailto: plus an address of yours; leave empty without push
# Approval cards in these hours (house time zone) stay in the app without a push;
# an unanswered card expires and the action is not performed. "off" pushes always.
APPROVAL_QUIET_HOURS=23-6

# ── ElevenLabs (voice replies, optional) ─────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=         # voice ID for voice_reply (optional, has a default)

# ── Inlet worker LLM (classification call) ─────────────────────────────
OPENROUTER_API_KEY=          # any OpenAI-compatible LLM endpoint key
INLET_MODEL=qwen/qwen3.5-9b  # override to any cheap, fast classifier model
INLET_DEDUPE_TURN_TTL=300    # suppress identical inlet blocks for N turns
INLET_EXPAND=1               # /expand neighbours, episode context and correction warnings; 0 disables (docs/inlet.md)
INLET_TEMPORAL=1             # time channel: "yesterday", "last Tuesday", dates search the sessions of that day; 0 disables (docs/inlet.md)

# ── enrich-header subagent / OpenRouter call ────────────────────────────
ENRICH_MODEL=openai/gpt-4.1-mini      # cheap fast model for RAG header rewrite
ENRICH_API_URL=https://openrouter.ai/api/v1/chat/completions

# An own mail address for the agent is an Embervy Quickstart add-on that sets
# these itself; leave them empty otherwise to keep the add-on doors closed.
EMAIL_SENDER_URL=
EMAIL_SENDER_AUTH=
EMAIL_WORKER_TOKEN=

# ── Claude Code substrate ────────────────────────────────────────────────
EMBERVY_TMUX_SESSION=embervy              # tmux session name for Claude Code loop
EMBERVY_APP_SERVICE=embervy-app.service    # systemd service name
EMBERVY_CHANNELS=app                      # MCP server names for Claude Code channel
EMBERVY_MCP_LIST=app                      # cosmetic, shown in restart notification
CLAUDE_PROCESS_PATTERN=                  # pgrep pattern for the claude process (default "claude.*server:")

# ── Watchdog thresholds (defaults shown) ─────────────────────────────────
# The Claude Code watchdog re-reads these keys from the app .env
# (Claude/app/.env) on every check: an edit there applies within a minute,
# no cut, no restart. WATCHDOG_WARN_TOKENS_<ENGINE> / _CUT_TOKENS_<ENGINE>
# set one engine and win over the two generic keys. GPT, Kimi and MiniMax
# have their own, smaller windows and take only their engine keys
# (defaults gpt 200000/220000, kimi 180000/210000, minimax 150000/180000).
# WATCHDOG_CHECK_INTERVAL is read at service start.
WATCHDOG_WARN_TOKENS=800000
WATCHDOG_CUT_TOKENS=900000
WATCHDOG_CHECK_INTERVAL=60
WATCHDOG_STATE_PATH=         # override the watchdog state file path (optional)

# ── Reply-tool detection (used by RAG export to capture app replies) ─────
# Defaults recognize the app MCP tools. Override only for a custom app channel.
# REPLY_TOOL_NAMES=mcp__app__reply,mcp__app__send
# EMAIL_TOOL_NAMES=mcp__app__email

# ── Memory: who rewrites the window? (set once by the installer) ────────
# off (default): the harness never summarizes the window in its own words;
#   the watchdog cuts near the limit, the bridge carries the last turns
#   verbatim, the chronicle keeps every word. Price: a cold read after a
#   pause, more tokens on a long day.
# on: the harness compacts when the window fills; cheaper per turn, and the
#   agent's day becomes a report it did not write.
EMBERVY_AUTO_COMPACT=off

# ── Ground layer: optional hooks (set once by the installer, all off) ────
# Without any of these the ambient line every fifth turn is time, window
# fill and model only. 1 = on, 0 = off.
EMBERVY_HOOK_CALENDAR=0       # calendar: today's entries next to the clock + phone feed + your ICS links (docs/calendar.md)
EMBERVY_HOOK_WEATHER=0        # one weather line under the clock (Open-Meteo, keyless; needs EMBERVY_WEATHER_PLACE)
EMBERVY_BROWSER=0             # the agent's own headless browser (shared/tools/browser; ~500 MB RAM while it runs, ~600 MB disk)
# EMBERVY_BROWSER_PORT=3055   # browser daemon on 127.0.0.1 — choose an unused port before enabling it, especially on a shared server
# IP/CIDR exceptions allow trusted private destinations; hostnames are not accepted because DNS can change.
# An own app uses EMBERVY_BROWSER_ALLOW=127.0.0.1:3030; a Tailscale device uses EMBERVY_BROWSER_ALLOW=100.101.102.103.
# Entries without a port use 80/443, and IPv6 ports use brackets, so permissions stay explicit.
# The daemon reads the environment or this file at startup, so stop it once with browse.py stop after changes.
# EMBERVY_BROWSER_ALLOW=127.0.0.1:3030,100.101.102.103
EMBERVY_CACHE_PING=0          # Claude Code loop only: optional silent cache keep-warm turn; default off
                             # costs a full cached call; useful for large windows and short idle gaps (docs/cache-ping.md)
EMBERVY_CACHE_PING_MINUTES=   # required when enabled; 5-minute polling needs margin: e.g. 50 for a verified 60m cache, 20 for 30m

# ── Calendar (read only while EMBERVY_HOOK_CALENDAR=1; docs/calendar.md) ──
# Phone-feed secret: https://<app>/calendar.ics?token=<this>. The installer
# creates it once and keeps it; rotate: bun shared/calendar/feed-token.ts rotate
CALENDAR_FEED_TOKEN=
# Your own calendars, read-only (no CalDAV, never written): secret ICS links,
# comma-separated, in single quotes — e.g. CALENDAR_ICS_URLS='https://…,webcal://…'
CALENDAR_ICS_URLS=
# How often the app reads those links, in minutes (5–1440).
CALENDAR_ICS_POLL_MINUTES=15
# Public app address (the installer writes it); lets the agent hand out the feed link.
EMBERVY_APP_URL=

# ── Claude Code overrides (Claude substrate only) ───────────────────────
# DISABLE_AUTO_COMPACT is derived from EMBERVY_AUTO_COMPACT by the loop.
DISABLE_COMPACT=true
CLAUDE_CODE_MAX_CONTEXT_TOKENS=1000000
CLAUDE_CODE_BLOCKING_LIMIT_OVERRIDE=950000
CLAUDE_CODE_ENABLE_PROMPT_SUGGESTION=false

# ── Optional image generation ────────────────────────────────────────────
BFL_API_KEY=

# ── Optional: think on a ChatGPT subscription (Claude substrate) ─────────
# One-time `codex login` writes ~/.codex/auth.json. The loop then starts
# shared/tools/chatgpt-oauth-adapter.ts, points Claude Code at it and lowers
# the watchdog thresholds (WATCHDOG_WARN_TOKENS_GPT / WATCHDOG_CUT_TOKENS_GPT
# change them; an edit applies within a minute). A backend switch needs a
# respawn.
# See shared/tools/CHATGPT-ADAPTER.md.
# EMBERVY_BACKEND=gpt
# EMBERVY_GPT_MODEL=gpt-5.6-terra
# EMBERVY_GPT_EFFORT=medium
# EMBERVY_GPT_CACHE_KEY=my-agent
# GPT_ADAPTER_PORT=3041
